+    def _kv_diag(self, tag: str) -> None:
+
+        """Optional page-accounting trace (FREETOKEN_KV_DIAG=1) written straight to a file:
+
+        `gap` must stay 0; a non-zero gap right after a cache_req pinpoints the leaking path."""
+
+        if not _KV_DIAG_ENABLED:
+
+            return
+
+        try:
+
+            pc = self.prefix_cache
+
+            if self.is_hybrid:
+
+                tree_pages = (pc.full_evictable + pc.full_protected) // self.page_size
+
+            else:
+
+                tree_pages = pc.size_info.total_size // self.page_size
+
+            free_pages = len(self.free_slots)
+
+            with open(r"C:\AI_Models\logs\kv_diag.log", "a", encoding="utf-8") as fh:
+
+                fh.write(
+
+                    f"{tag} free={free_pages} tree={tree_pages} "
+
+                    f"gap={self.num_pages - free_pages - tree_pages}"
+
+                    + (
+
+                        f" mambae={pc.mamba_evictable} mambap={pc.mamba_protected}"
+
+                        f" poolfree={self.linear_state_pool.num_free_slots}"
+
+                        if self.is_hybrid
+
+                        else ""
+
+                    )
+
+                    + "\n"
+
+                )
+
+        except Exception:
+
+            pass
