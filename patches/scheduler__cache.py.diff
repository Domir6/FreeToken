+    def _tree_page_starts(self) -> set:
+
+        """Page-start token indices currently owned by the radix tree (all live nodes)."""
+
+        pages = set()
+
+        root = getattr(self.prefix_cache, "root_node", None)
+
+        if root is None:
+
+            return pages
+
+        stack = [root]
+
+        while stack:
+
+            node = stack.pop()
+
+            if not node.is_root():
+
+                try:
+
+                    pages.update(int(x) for x in node.value[:: self.page_size].tolist())
+
+                except Exception:
+
+                    pass
+
+            stack.extend(list(node.children.values()))
+
+        return pages
+
+    def _recycle_orphan_pages(self) -> int:
+
+        """Idle-only safety net: a page that is neither free nor owned by the tree was orphaned
+
+        (a request that died mid-abort). Recycle it instead of killing the server."""
+
+        tree = self._tree_page_starts()
+
+        free = {int(x) for x in self.free_slots.tolist()}
+
+        total = self.num_pages * self.page_size
+
+        orphan = [p for p in range(0, total, self.page_size) if p not in tree and p not in free]
+
+        if not orphan:
+
+            return 0
+
+        self.free_slots = torch.cat(
+
+            [
+
+                self.free_slots,
+
+                torch.tensor(orphan, dtype=self.free_slots.dtype, device=self.free_slots.device),
+
+            ]
+
+        )
+
+        return len(orphan)
