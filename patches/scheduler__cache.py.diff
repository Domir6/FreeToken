+
+
+
+        from freetoken.kvcache.hybrid_radix_cache import HybridCacheHandle
+
+
+
+        try:
+
+            node, prefix_len = walk(input_ids)
+
+        except Exception:
+
+            return None
+
+
+
+        cur, end_len = node, prefix_len
+
+
+
+        while not cur.is_root() and end_len > handle.cached_len:
